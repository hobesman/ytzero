<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application>
    <!-- Android Auto lists the app as a media app because of this. -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/ytzero_automotive_app_desc" />
    <!-- Music mode's player and music library (Android Auto browses it). Separate from expo-video's service, so music and video never share a media session. -->
    <service
      android:name="app.ytzero.musicplayer.YtZeroMusicService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService" />
        <action android:name="androidx.media3.session.MediaSessionService" />
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>
  </application>
</manifest>
